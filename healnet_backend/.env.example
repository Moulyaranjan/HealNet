# HEALNET Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# ==============================================================================
# Hardware Serial Port Configuration (Coordinator ESP32)
# ==============================================================================
# Testing port assignments:
#   COM9  = Sensor Node 1   (DO NOT open from Python backend)
#   COM11 = Sensor Node 2   (DO NOT open from Python backend)
#   COM14 = Coordinator     (ONLY this port is opened by serial_bridge.py)
# On Linux, typically /dev/ttyUSB0 or /dev/ttyACM0.
HEALNET_SERIAL_PORT=COM14
HEALNET_SERIAL_BAUD=115200

# ==============================================================================
# Local MQTT Broker (Mosquitto)
# ==============================================================================
HEALNET_MQTT_HOST=127.0.0.1
HEALNET_MQTT_PORT=1883
HEALNET_MQTT_USER=
HEALNET_MQTT_PASS=
HEALNET_MQTT_KEEPALIVE=30

# ==============================================================================
# Local REST API (FastAPI + Uvicorn)
# ==============================================================================
HEALNET_API_HOST=127.0.0.1
HEALNET_API_PORT=8000

# ==============================================================================
# Database and Storage Settings
# ==============================================================================
# SQLite database path (default: data/healnet.db)
HEALNET_DB_PATH=data/healnet.db
# Retention period for historical sensor readings (in days)
HEALNET_RETENTION_DAYS=30

# ==============================================================================
# Timing and Threshold Settings
# ==============================================================================
# Expected sensor transmission interval from ESP32 nodes (seconds)
HEALNET_SENSOR_INTERVAL_S=2.0
# Missed packet intervals for stale / offline node detection
HEALNET_NODE_STALE_S=6.0
HEALNET_NODE_TIMEOUT_S=10.0
# Startup grace period before triggering offline timeouts
HEALNET_STARTUP_GRACE_S=12.0
# LDR ADC rail thresholds (12-bit ADC: 0..4095)
HEALNET_LDR_RAIL_LOW=3
HEALNET_LDR_RAIL_HIGH=4092

# ==============================================================================
# Machine Learning Settings
# ==============================================================================
HEALNET_ML_ENABLED=true
HEALNET_ML_CONTAMINATION=0.02
HEALNET_ML_MODEL_DIR=models

